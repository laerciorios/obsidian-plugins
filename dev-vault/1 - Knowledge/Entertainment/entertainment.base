filters:
  and:
    - file.inFolder("1 - Knowledge/Entertainment/DB")
properties:
  note.title:
    displayName: Título
  note.kind:
    displayName: Tipo
  note.author:
    displayName: Autor ou artista
  note.season:
    displayName: Temporada
  note.year:
    displayName: Ano
  note.status:
    displayName: Status
  note.rating:
    displayName: Nota
  note.finished:
    displayName: Concluído
  note.platform:
    displayName: Plataforma
  note.tracks:
    displayName: Faixas
views:
  - type: table
    name: Todos
    order:
      - file.name
      - kind
      - season
      - year
      - status
      - rating
      - finished
      - platform
  - type: cards
    name: Galeria
    order:
      - file.name
      - title
      - kind
      - year
      - rating
    image: note.cover
  - type: table
    name: Álbuns
    filters:
      and:
        - kind == "album"
    order:
      - file.name
      - author
      - year
      - tracks
      - status
      - rating
      - finished
      - platform
    sort:
      - property: finished
        direction: DESC
