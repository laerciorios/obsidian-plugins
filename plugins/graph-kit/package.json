{
	"name": "graph-kit",
	"version": "0.8.0",
	"private": true,
	"description": "Customizes the native graph view: note labels from properties and more, each feature toggled on its own.",
	"main": "dist/main.js",
	"scripts": {
		"dev": "node ../../scripts/esbuild.mjs",
		"build": "tsc --noEmit && node ../../scripts/esbuild.mjs --production",
