# dependencies
node_modules/

# build output (release artifacts go to GitHub releases / the vault, never to git)
dist/
plugins/*/main.js
*.map

# local machine config
.dev-targets.json
.env
.env.local

# dev vault: everything under plugins/ is generated (hot-reload download + build copies)
dev-vault/.obsidian/plugins/
dev-vault/.obsidian/workspace*.json
dev-vault/.obsidian/cache
dev-vault/.trash/

# editors / OS
.vscode/
.idea/
*.iml
.DS_Store

# dev vault: Archive Lab notes are generated by `pnpm --filter bases-board fixtures`
dev-vault/Archive Lab/Projects/
dev-vault/Archive Lab/Central/
dev-vault/Archive Lab/Broken/
dev-vault/Archive Lab/Boards/

# dev vault: Hierarchy Lab notes are generated by `pnpm --filter bases-board fixtures:hierarchy`
dev-vault/Hierarchy Lab/Projects/
dev-vault/Hierarchy Lab/Stress/
